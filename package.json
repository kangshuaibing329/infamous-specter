{
  "name":"wordquest","private":true,"version":"0.1.0","packageManager":"pnpm@12.14.0",
  "engines":{"node":">=22.12.0"},
  "scripts":{
    "dev":"pnpm --filter @wordquest/web dev",
    "build":"pnpm --filter @wordquest/web build",
    "typecheck":"pnpm --filter @wordquest/game-core typecheck && pnpm --filter @wordquest/storage typecheck && pnpm --filter @wordquest/web typecheck",
    "test":"pnpm --filter @wordquest/game-core test",
    "test:e2e":"pnpm build && pnpm --filter @wordquest/web test:e2e",
    "verify":"pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "devDependencies":{
    "@playwright/test":"1.64.1","@types/node":"24.19.2","@types/react":"19.3.0","@types/react-dom":"19.3.0","typescript":"7.0.2","vitest":"5.0.5"
  }
}